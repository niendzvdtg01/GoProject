# Copy to `.env` (same directory as docker-compose.yml) and adjust for your
# environment. Compose loads this file automatically; defaults match the
# values baked into docker-compose.yml so the stack runs out of the box.

# ── Backend ─────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-prod
BACKEND_PORT=8080

# ── MySQL ───────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=rootpass
DB_NAME=miniproject_database
DB_USERNAME=user
DB_PASSWORD=1234
DB_EXTERNAL_PORT=3311

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_EXTERNAL_PORT=6379

# ── RabbitMQ ────────────────────────────────────────────────────────────────
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_AMQP_PORT=5672
RABBITMQ_UI_PORT=15672

# ── Observability ───────────────────────────────────────────────────────────
LOKI_PORT=3100
GRAFANA_PORT=3000
GRAFANA_PASSWORD=admin
